{
  "name": "cascade",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "rm -rf dist && concurrently --raw npm:dev:*",
    "build": "rm -rf dist && concurrently --raw npm:build:* && npm run pack",
    "dev:pages": "npm run build:pages -- --watch",
    "dev:assets": "npm run build:assets -- --watch",
    "dev:worker": "npm run build:worker -- --watch --sourcemap=inline",
    "dev:monaco": "npm run build:monaco -- --watch --sourcemap=inline",
    "build:pages": "esbuild src/*.page.ts --sourcemap --loader:.html=text --loader:.ttf=dataurl --bundle --outdir=dist/unpacked",
    "build:assets": "node scripts/copy-assets.js --src public --target dist/unpacked",
    "build:worker": "esbuild src/*.worker.ts  --loader:.html=text --format=esm --bundle --outdir=dist/unpacked",
    "build:monaco": "esbuild ./node_modules/monaco-editor/esm/vs/language/typescript/ts.worker ./node_modules/monaco-editor/esm/vs/editor/editor.worker.js --format=esm --bundle --outdir=dist/unpacked",
    "pack": "node scripts/pack.js --dir dist/unpacked",
    "test": "tsx ./src/index.test.ts"
  },
  "type": "module",
  "devDependencies": {
    "@types/chrome": "^0.0.318",
    "@types/node": "^20.2.5",
    "concurrently": "^9.1.2",
    "esbuild": "^0.25.3",
    "prettier": "^3.5.3",
    "tsx": "^4.19.4"
  },
  "dependencies": {
    "monaco-editor": "^0.52.2",
    "rxjs": "^7.8.2",
    "vanilla-jsoneditor": "^3.3.1"
  }
}
